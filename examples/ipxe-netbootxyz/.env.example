# Host bridge used by the PXE service and VM NIC.
PXE_BRIDGE_NAME=ipxe-lab-br

# Isolated PXE subnet. Use an address range that does not overlap your LAN.
NETBOOT_SUBNET=192.0.2.0/24
NETBOOT_ROUTER=192.0.2.1
NETBOOT_IP=192.0.2.1
NETBOOT_DHCP_RANGE_START=192.0.2.50
NETBOOT_DHCP_RANGE_END=192.0.2.100
NETBOOT_DNS=1.1.1.1

# Host ports used by netboot.xyz and the VM browser console.
NETBOOT_HTTP_PORT=8080
NETBOOT_WEB_PORT=3000
NOVNC_PORT=6081
VNC_PORT=5901
